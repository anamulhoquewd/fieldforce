GOOGLE_MAPS_API_KEY=your_google_maps_api_key # Google Maps API key, যা Google Cloud Console থেকে পেতে হবে

EMAIL_USER=*****@gmail.com   # ইমেইল সার্ভিসের জন্য ইউজারনেম (যেমন Gmail অ্যাকাউন্ট)
EMAIL_PASS=*******         # ইমেইল সার্ভিসের জন্য পাসওয়ার্ড (যদি Gmail ব্যবহার করেন, তাহলে অ্যাপ পাসওয়ার্ড তৈরি করতে হবে)

R2_ACCESS_KEY=*************************************************     # R2 (Cloudflare R2) এর Access Key
R2_SECRET_KEY=**************************************************    # R2 (Cloudflare R2) এর Secret Key
R2_ENDPOINT=https://*******************.r2.cloudflarestorage.com    # R2 (Cloudflare R2) এর Endpoint URL
R2_BUCKET=fieldforce                                                            # R2 (Cloudflare R2) এর Bucket Name

# ---------- Server ----------
PORT=8000                          # server কোন port-এ চলবে (Next.js 3000-এ চলে, তাই আলাদা রাখলাম)
NODE_ENV=development               # development নাকি production — কিছু আচরণ এর উপর নির্ভর করে

# ---------- Database (Neon Postgres) ----------
# Neon-এ project খুললে এই connection string পাবে — পুরোটা কপি করে বসাবে
DATABASE_URL=postgresql://neondb_owner:**************@**************.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- Redis (Upstash) ----------
# Upstash-এ database খুললে "Redis URL" (rediss:// দিয়ে শুরু) পাবে
REDIS_URL=rediss://default:**************@***********.upstash.io:6379
# ---------- Auth ----------
# Session/cookie sign করার গোপন চাবি — লম্বা এলোমেলো string দেবে
# টার্মিনালে এটা চালিয়ে বানাতে পারো: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_random_string

# ---------- CORS ----------
# কোন frontend থেকে request আসা বৈধ — এখন localhost, deploy-এর পর আসল domain
CLIENT_ORIGIN=http://localhost:3000